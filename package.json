{
  "name": "better-jsonl",
  "displayName": "Better JSONL",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "andy",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Formatters",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "jsonl",
    "ndjson",
    "json lines",
    "json",
    "viewer",
    "formatter",
    "grid",
    "graph"
  ],
  "galleryBanner": {
    "color": "#14161b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:jsonl",
    "onWebviewPanel:betterJsonl.preview"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "betterJsonl.viewer",
        "displayName": "Better JSONL",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.jsonlines"
          },
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "betterJsonl.openPreviewToSide",
        "title": "%command.openPreviewToSide%",
        "icon": {
          "light": "media/glyph-light.svg",
          "dark": "media/glyph-dark.svg"
        }
      },
      {
        "command": "betterJsonl.openPreview",
        "title": "%command.openPreview%"
      },
      {
        "command": "betterJsonl.openInViewer",
        "title": "%command.openInViewer%"
      },
      {
        "command": "betterJsonl.openAsText",
        "title": "%command.openAsText%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "betterJsonl.showFormatted",
        "title": "%command.showFormatted%"
      },
      {
        "command": "betterJsonl.showGrid",
        "title": "%command.showGrid%"
      },
      {
        "command": "betterJsonl.showGraph",
        "title": "%command.showGraph%"
      },
      {
        "command": "betterJsonl.toggleExpandMode",
        "title": "%command.toggleExpandMode%"
      },
      {
        "command": "betterJsonl.toggleWordWrap",
        "title": "%command.toggleWordWrap%"
      },
      {
        "command": "betterJsonl.expandLines",
        "title": "%command.expandLines%"
      },
      {
        "command": "betterJsonl.compactLines",
        "title": "%command.compactLines%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "betterJsonl.openPreviewToSide",
          "when": "resourceLangId == json || resourceLangId == jsonc || resourceLangId == jsonl || resourceExtname == .json || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .jsonlines",
          "group": "navigation@-100"
        },
        {
          "command": "betterJsonl.openAsText",
          "when": "activeCustomEditorId == betterJsonl.viewer",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "betterJsonl.openPreviewToSide",
          "when": "resourceExtname == .json || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .jsonlines",
          "group": "0_betterJsonl@1"
        },
        {
          "command": "betterJsonl.openInViewer",
          "when": "resourceExtname == .json || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .jsonlines",
          "group": "0_betterJsonl@2"
        }
      ],
      "editor/context": [
        {
          "command": "betterJsonl.openPreviewToSide",
          "when": "editorLangId == json || editorLangId == jsonc || editorLangId == jsonl || resourceExtname == .jsonlines",
          "group": "0_betterJsonl@1"
        },
        {
          "command": "betterJsonl.openInViewer",
          "when": "editorLangId == json || editorLangId == jsonc || editorLangId == jsonl || resourceExtname == .jsonlines",
          "group": "0_betterJsonl@2"
        },
        {
          "command": "betterJsonl.expandLines",
          "when": "editorLangId == jsonl || resourceExtname == .jsonlines",
          "group": "0_betterJsonl@3"
        },
        {
          "command": "betterJsonl.compactLines",
          "when": "editorLangId == jsonl || resourceExtname == .jsonlines",
          "group": "0_betterJsonl@4"
        }
      ],
      "explorer/context": [
        {
          "command": "betterJsonl.openPreviewToSide",
          "when": "resourceExtname == .json || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .jsonlines",
          "group": "navigation@20"
        },
        {
          "command": "betterJsonl.openInViewer",
          "when": "resourceExtname == .json || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .jsonlines",
          "group": "navigation@21"
        }
      ],
      "commandPalette": [
        {
          "command": "betterJsonl.openAsText",
          "when": "activeCustomEditorId == betterJsonl.viewer"
        },
        {
          "command": "betterJsonl.expandLines",
          "when": "editorLangId == jsonl || resourceExtname == .jsonlines"
        },
        {
          "command": "betterJsonl.compactLines",
          "when": "editorLangId == jsonl || resourceExtname == .jsonlines || editorLangId == json"
        }
      ]
    },
    "keybindings": [
      {
        "command": "betterJsonl.openPreviewToSide",
        "key": "ctrl+k j",
        "mac": "cmd+k j",
        "when": "editorTextFocus && editorLangId == json || editorTextFocus && editorLangId == jsonc || editorTextFocus && editorLangId == jsonl || editorTextFocus && resourceExtname == .jsonlines"
      },
      {
        "command": "betterJsonl.toggleWordWrap",
        "key": "alt+z",
        "when": "activeWebviewPanelId == 'betterJsonl.preview' || activeCustomEditorId == 'betterJsonl.viewer'"
      }
    ],
    "configuration": {
      "title": "Better JSONL",
      "properties": {
        "betterJsonl.defaultView": {
          "type": "string",
          "enum": [
            "formatted",
            "grid",
            "graph"
          ],
          "enumDescriptions": [
            "%config.defaultView.formatted%",
            "%config.defaultView.grid%",
            "%config.defaultView.graph%"
          ],
          "default": "formatted",
          "description": "%config.defaultView%"
        },
        "betterJsonl.theme": {
          "type": "string",
          "enum": [
            "vscode",
            "light",
            "dark",
            "system"
          ],
          "enumDescriptions": [
            "%config.theme.vscode%",
            "%config.theme.light%",
            "%config.theme.dark%",
            "%config.theme.system%"
          ],
          "default": "vscode",
          "description": "%config.theme%"
        },
        "betterJsonl.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "简体中文"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "betterJsonl.wordWrap": {
          "type": "string",
          "enum": [
            "followEditor",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "%config.wordWrap.followEditor%",
            "%config.wordWrap.on%",
            "%config.wordWrap.off%"
          ],
          "default": "followEditor",
          "description": "%config.wordWrap%"
        },
        "betterJsonl.jsonl.expandMode": {
          "type": "string",
          "enum": [
            "focus",
            "all"
          ],
          "enumDescriptions": [
            "%config.jsonl.expandMode.focus%",
            "%config.jsonl.expandMode.all%"
          ],
          "default": "focus",
          "description": "%config.jsonl.expandMode%"
        },
        "betterJsonl.indent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "description": "%config.indent%"
        },
        "betterJsonl.graph.maxNodes": {
          "type": "integer",
          "minimum": 50,
          "maximum": 20000,
          "default": 1500,
          "description": "%config.graph.maxNodes%"
        },
        "betterJsonl.preview.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "%config.preview.followActiveEditor%"
        },
        "betterJsonl.syncSelection": {
          "type": "boolean",
          "default": true,
          "description": "%config.syncSelection%"
        },
        "betterJsonl.formatDocument.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.formatDocument.enabled%"
        },
        "betterJsonl.expandLines.showReminder": {
          "type": "boolean",
          "default": true,
          "description": "%config.expandLines.showReminder%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "icon": "rsvg-convert -w 128 -h 128 media/icon.svg -o media/icon.png",
    "package": "npm run typecheck && node esbuild.mjs --production && node -e \"require('fs').mkdirSync('dist-vsix',{recursive:true})\" && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links -o dist-vsix/",
    "test:e2e:host": "node esbuild.mjs && node test/host/run.mjs",
    "test:e2e:web": "node esbuild.mjs && node test/web/run.mjs",
    "test:e2e": "npm run test:e2e:host && npm run test:e2e:ui && npm run test:e2e:web",
    "test:e2e:ui": "npm run package && node test/ui/run.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "jsonc-parser": "^3.3.1",
    "mocha": "^10.8.2",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3"
  }
}
